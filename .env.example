# STRATUM-F1 — environment template
# Copy to `.env` and fill in your key(s). `.env` is gitignored; never commit it.

# Free Gemini backend (default provider). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Claude backend. Set STRATUM_LLM_PROVIDER=claude to use it.
# ANTHROPIC_API_KEY=

# Optional: which LLM backend to use ("gemini" or "claude"; default gemini)
# STRATUM_LLM_PROVIDER=gemini
